DATABASE_URL="file:./prod.db"

# Telegram Bot (obtener de @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# The Odds API (https://the-odds-api.com — plan gratuito: 500 créditos/mes)
ODDS_API_KEY=

# IA: elegir uno (openai | anthropic)
AI_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

PORT=3000
NODE_ENV=production

# Sports a seguir (claves de The Odds API)
# Ligas europeas (activas ago-may): soccer_epl, soccer_spain_la_liga, soccer_italy_serie_a, soccer_germany_bundesliga, soccer_france_ligue_one
# Activos ahora (jun 2026): soccer_fifa_world_cup, soccer_conmebol_copa_libertadores, soccer_brazil_serie_b
TRACKED_SPORTS=soccer_fifa_world_cup,soccer_conmebol_copa_libertadores,soccer_conmebol_copa_sudamericana,soccer_brazil_serie_b

# EV mínimo para alertar (0.05 = 5%)
EV_THRESHOLD=0.05

# Confianza mínima: LOW | MEDIUM | HIGH
MIN_CONFIDENCE=MEDIUM

# Cron de análisis (default: 1 vez por día a las 8am — 450 créditos/mes con 5 sports)
FETCH_CRON=0 8 * * *
